{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 15,
      "maxLength": 65
    },
    "metaDescription": {
      "type": "string",
      "minLength": 70,
      "maxLength": 165
    },
    "h1": {
      "type": "string",
      "minLength": 5,
      "maxLength": 90
    },
    "summary": {
      "type": "string",
      "minLength": 60
    },
    "lastUpdated": {
      "type": "string",
      "format": "date-time"
    },
    "draft": {
      "default": false,
      "type": "boolean"
    },
    "related": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "faqs": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "minLength": 10
          },
          "a": {
            "type": "string",
            "minLength": 40
          }
        },
        "required": [
          "q",
          "a"
        ]
      }
    },
    "term": {
      "type": "string",
      "minLength": 2
    },
    "definition": {
      "type": "string",
      "minLength": 40
    },
    "relatedTerms": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "metaDescription",
    "summary",
    "lastUpdated",
    "term",
    "definition"
  ]
}